# Smart Attendance Management System - environment template
# Copy this file to .env in the project root (and to backend/.env if running
# the backend standalone) and fill in real values. Never commit the filled
# .env file.

# --- Application -------------------------------------------------------
# Flask secret used to sign session cookies. Any long random string works
# for local development; use a generated 32+ byte value in production.
SECRET_KEY=dev-secret-change-me

# Set to 1 to enable Flask debug/reload mode. Leave at 0 in production.
FLASK_DEBUG=0

# Port the Flask API listens on.
PORT=5000

# Comma-separated list of origins allowed to call the API (the frontend URL).
CORS_ORIGINS=http://localhost:5173

# --- Facial recognition tuning ------------------------------------------
# Directory holding the YuNet/SFace ONNX weights (populated by
# backend/download_models.py).
MODEL_DIR=./backend/models_data

# Maximum embedding distance accepted as a match. Lower is stricter.
FACE_MATCH_THRESHOLD=1.02

# Eye Aspect Ratio below which an eye is considered closed for blink/liveness
# detection.
LIVENESS_EAR_THRESHOLD=0.21

# Consecutive below-threshold frames required before a blink is counted,
# filtering out single-frame detector noise.
LIVENESS_CONSEC_FRAMES=2

# --- NUC compliance ------------------------------------------------------
# Minimum attendance percentage a student must maintain per NUC guidelines.
NUC_ATTENDANCE_THRESHOLD=75.0

# =========================================================================
# Third-party provider settings
# =========================================================================

# --- Database -------------------------------------------------------------
# SQLite is the default development fallback and needs no setup.
# For PostgreSQL: postgresql+psycopg2://<user>:<password>@<host>:5432/<db>
# For MySQL:      mysql+pymysql://<user>:<password>@<host>:3306/<db>
DATABASE_URL=sqlite:///attendance.db

# --- Authentication (JWT) --------------------------------------------------
# Secret used to sign access/refresh tokens. Must differ from SECRET_KEY and
# be at least 32 bytes long.
JWT_SECRET_KEY=dev-jwt-secret-change-me-please-32-bytes

# Access token lifetime in minutes.
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30

# Refresh token lifetime in days.
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# --- SMTP / Mail (attendance alerts, low-attendance notices) --------------
MAIL_SERVER=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@smartattendance.ng

# --- WebRTC / STUN / TURN (live camera streaming) -------------------------
# Public STUN server is sufficient for most campus networks; a TURN server
# is only required behind restrictive NAT/firewalls.
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# --- Asset storage (optional cloud storage for exported reports) ---------
# Leave blank to keep exported CSV/PDF reports as local, on-demand downloads.
CLOUD_STORAGE_PROVIDER=
CLOUD_STORAGE_BUCKET=
CLOUD_STORAGE_ACCESS_KEY=
CLOUD_STORAGE_SECRET_KEY=

# --- Frontend --------------------------------------------------------------
# Base URL the SPA uses to reach the API. Vite only exposes variables
# prefixed with VITE_ to client-side code.
VITE_API_BASE_URL=http://localhost:5000/api

# Origin serving the face-api.js model weights used for client-side blink
# detection and the offline recognition fallback. Defaults to a public
# jsDelivr mirror of the face-api.js weights folder; point this at a
# same-origin /models path for deployments without outbound internet access.
VITE_FACE_MODEL_URL=
